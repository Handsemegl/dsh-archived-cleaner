{
  "name": "dsh-archived-cleaner",
  "version": "0.1.0",
  "description": "DSH plugin: list and permanently delete archived conversations from the settings page (archived-only, double confirmation)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-alpha.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "cordis",
    "plugin",
    "archive",
    "session",
    "cleanup",
    "delete"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node scripts/eval-check.mjs"
  }
}
